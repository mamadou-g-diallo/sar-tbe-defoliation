# Données volumineuses (régénérables via download_data.py / feature_extraction.py,
# ou trop lourdes / sous licence tierce pour être versionnées)
data/tbe_raw/
data/*/raw/
data/*/processed/

# Garder : data/shp/ (définition d'AOI, léger) et data/*/results/ (CSV + figures,
# démonstration des résultats, quelques centaines de Ko)
# cache régénérable (embeddings 2048-d x n échantillons, ~25 Mo)
data/*/results/*embeddings*.csv

__pycache__/
*.pyc
.ipynb_checkpoints/

# Notebooks tutoriel PyGMTSAR (matériel d'apprentissage personnel, pas notre
# code : bio/promo de l'auteur non retirée, chemins d'une autre machine,
# cellules en erreur — pas la chaîne SNAP documentée dans ce dossier) — jamais
# versionnés, même si un `git add .` les recroise un jour.
insar_coherence_snap/*.ipynb

# Docs de travail (PDF/DOCX générés localement pour la candidature, hors dépôt)
*.docx
*.pdf
*.tex
.~lock.*#

.DS_Store
